{%- comment -%}
  Section : Bannière d'accueil (hero)
  Image en arrière-plan plein écran + bloc texte aligné.
  Personnalisable depuis l'éditeur de thème.
{%- endcomment -%}

{%- liquid
  assign couleur_fond = section.settings.couleur_fond
  assign alignement_texte = section.settings.alignement_texte
  assign hauteur = section.settings.hauteur
  assign intensite_overlay = section.settings.intensite_overlay
-%}

<section
  class="banniere-accueil banniere-accueil--{{ hauteur }} banniere-accueil--align-{{ alignement_texte }}"
  style="--banniere-fond: {{ couleur_fond }}; --banniere-overlay: {{ intensite_overlay | divided_by: 100.0 }};"
>
  {%- if section.settings.image != blank -%}
    {%- assign image_hero = section.settings.image -%}
    {{
      image_hero
      | image_url: width: 2400
      | image_tag:
        class: 'banniere-accueil__image-fond',
        loading: 'eager',
        fetchpriority: 'high',
        widths: '600, 900, 1200, 1600, 2000, 2400',
        sizes: '100vw'
    }}
  {%- endif -%}

  <div class="banniere-accueil__voile" aria-hidden="true"></div>

  <div class="banniere-accueil__contenu">
    <div class="banniere-accueil__texte">
      {%- if section.settings.surtitre != blank -%}
        <p class="banniere-accueil__surtitre">{{ section.settings.surtitre }}</p>
      {%- endif -%}

      {%- if section.settings.titre != blank -%}
        <h1 class="banniere-accueil__titre">{{ section.settings.titre }}</h1>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="banniere-accueil__description">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if section.settings.lien_bouton != blank and section.settings.texte_bouton != blank -%}
        <a
          href="{{ section.settings.lien_bouton }}"
          class="bouton bouton--primaire banniere-accueil__bouton"
        >
          {{ section.settings.texte_bouton }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bannière d'accueil",
  "tag": "section",
  "class": "section-banniere",
  "settings": [
    { "type": "header", "content": "Contenu" },
    {
      "type": "text",
      "id": "surtitre",
      "label": "Surtitre (italique)",
      "default": "La beauté sans compromis"
    },
    {
      "type": "text",
      "id": "titre",
      "label": "Titre principal",
      "default": "Des soins purs pour révéler votre éclat naturel."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Formules clean, ingrédients d'origine naturelle, packagings éco-responsables.</p>"
    },
    {
      "type": "text",
      "id": "texte_bouton",
      "label": "Texte du bouton",
      "default": "Découvrir la collection"
    },
    { "type": "url", "id": "lien_bouton", "label": "Lien du bouton" },

    { "type": "header", "content": "Visuel" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image d'arrière-plan",
      "info": "Format paysage recommandé (ex. 2400×1400 px)."
    },
    {
      "type": "select",
      "id": "alignement_texte",
      "label": "Alignement du texte",
      "options": [
        { "value": "gauche", "label": "Gauche" },
        { "value": "centre", "label": "Centre" },
        { "value": "droite", "label": "Droite" }
      ],
      "default": "gauche"
    },
    {
      "type": "select",
      "id": "hauteur",
      "label": "Hauteur de la bannière",
      "options": [
        { "value": "moyenne", "label": "Moyenne (70vh)" },
        { "value": "grande", "label": "Grande (85vh)" },
        { "value": "plein-ecran", "label": "Plein écran (100vh)" }
      ],
      "default": "grande"
    },
    {
      "type": "range",
      "id": "intensite_overlay",
      "label": "Intensité du voile sur l'image",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 25
    },

    { "type": "header", "content": "Apparence" },
    {
      "type": "color",
      "id": "couleur_fond",
      "label": "Couleur de fond (sans image)",
      "default": "#F2EADB"
    }
  ],
  "presets": [{ "name": "Bannière d'accueil" }]
}
{% endschema %}
