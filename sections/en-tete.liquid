{%- comment -%}
  ============================================================
  Section : En-tête principal du site
  - Logo texte « PURETÉ » (Cormorant 500), option image disponible
  - Navigation centrée avec sous-menus (caret automatique)
  - Icônes recherche / compte / panier (badge dynamique)
  - Sticky : reste fixé en haut au scroll
  ============================================================
{%- endcomment -%}

<header
  class="en-tete sticky top-0 z-40 bg-creme border-b border-vert-profond/10 backdrop-blur-sm"
  role="banner"
  data-section-id="{{ section.id }}"
  data-en-tete
>
  <div class="container mx-auto flex items-center justify-between gap-6 py-5">
    {%- comment -%} ---------- Bouton burger (mobile) ---------- {%- endcomment -%}
    <button
      type="button"
      class="en-tete__burger lg:hidden"
      data-ouvre-menu-mobile
      aria-label="Ouvrir le menu"
      aria-expanded="false"
    >
      <span class="en-tete__burger-trait"></span>
      <span class="en-tete__burger-trait"></span>
      <span class="en-tete__burger-trait"></span>
    </button>

    {%- comment -%} ---------- Logo ---------- {%- endcomment -%}
    <a
      href="{{ routes.root_url }}"
      class="en-tete__logo font-titre text-logo text-vert-profond hover:text-sauge-fonce no-underline shrink-0"
      style="font-weight: 500;"
      aria-label="{{ shop.name }}"
    >
      {%- if section.settings.logo_image != blank -%}
        {{
          section.settings.logo_image
          | image_url: width: 400
          | image_tag: class: 'h-8 w-auto', alt: shop.name, loading: 'eager'
        }}
      {%- else -%}
        {{ section.settings.logo_texte | default: shop.name }}
      {%- endif -%}
    </a>

    {%- comment -%} ---------- Navigation principale (desktop) ---------- {%- endcomment -%}
    <nav
      class="en-tete__navigation hidden lg:flex flex-1 justify-center"
      role="navigation"
      aria-label="{{ 'accessibilite.navigation_principale' | t }}"
    >
      {%- liquid
        # ----------------------------------------------------------------
        # Fallback statique : si le menu admin Shopify est vide, on affiche
        # les liens du design (mockup). Dès que le client ajoutera des liens
        # dans Boutique en ligne → Navigation → main-menu, ceux-ci prendront
        # automatiquement le relais.
        # ----------------------------------------------------------------
        assign menu_admin = section.settings.menu.links
        assign utiliser_fallback = false
        if menu_admin.size == 0
          assign utiliser_fallback = true
        endif
      -%}

      <ul class="flex items-center gap-8">
        {%- if utiliser_fallback -%}
          {%- liquid
            assign current_path = request.path | downcase
            assign page_engagements = pages.engagements
            assign url_engagements = '/pages/engagements'
            if page_engagements != blank
              assign url_engagements = page_engagements.url
            endif

            assign page_quiz = pages['quiz-peau']
            if page_quiz == blank
              assign page_quiz = pages['quiz-de-peau']
            endif
            assign url_quiz = '/pages/quiz-peau'
            if page_quiz != blank
              assign url_quiz = page_quiz.url
            endif

            assign page_apropos = pages['a-propos']
            if page_apropos == blank
              assign page_apropos = pages.about
            endif
            assign url_apropos = '/pages/a-propos'
            if page_apropos != blank
              assign url_apropos = page_apropos.url
            endif

            assign url_blog = '/blogs/news'
            if blogs.news != blank
              assign url_blog = blogs.news.url
            elsif blogs.first != blank
              assign url_blog = blogs.first.url
            endif

            assign url_visage = routes.collections_url
            if collections.visage != blank
              assign url_visage = collections.visage.url
            elsif collections['soins-visage'] != blank
              assign url_visage = collections['soins-visage'].url
            endif

            assign url_serums = routes.collections_url
            if collections.serums != blank
              assign url_serums = collections.serums.url
            elsif collections.serum != blank
              assign url_serums = collections.serum.url
            endif

            assign url_nettoyants = routes.collections_url
            if collections.nettoyants != blank
              assign url_nettoyants = collections.nettoyants.url
            endif

            assign url_hydratants = routes.collections_url
            if collections.hydratants != blank
              assign url_hydratants = collections.hydratants.url
            endif

            assign actif_boutique = false
            if request.page_type == 'collection' or request.page_type == 'product' or current_path contains '/collections/'
              assign actif_boutique = true
            endif

            assign actif_engagements = false
            if current_path contains '/pages/engagement'
              assign actif_engagements = true
            endif

            assign actif_quiz = false
            if current_path contains '/pages/quiz'
              assign actif_quiz = true
            endif

            assign actif_blog = false
            if request.page_type == 'blog' or request.page_type == 'article' or current_path contains '/blogs/'
              assign actif_blog = true
            endif

            assign actif_apropos = false
            if current_path contains '/pages/a-propos' or current_path contains '/pages/about'
              assign actif_apropos = true
            endif

            if actif_engagements or actif_quiz or actif_blog or actif_apropos
              assign actif_boutique = false
            endif
          -%}
          {%- comment -%} ----- Menu statique de secours (4 entrées du mockup) ----- {%- endcomment -%}

          {%- comment -%} Boutique (avec sous-menu placeholder) {%- endcomment -%}
          <li class="en-tete__item-nav relative group">
            <a
              href="{{ routes.collections_url }}"
              class="en-tete__lien-nav font-corps text-nav text-vert-profond hover:text-sauge-fonce no-underline inline-flex items-center gap-1 py-2 {% if actif_boutique %}est-actif{% endif %}"
              style="font-weight: 500;"
              {% if actif_boutique %}
                aria-current="page"
              {% endif %}
            >
              Boutique
              {%- render 'icone',
                nom: 'chevron-bas',
                classe: 'inline-block transition-transform group-hover:rotate-180'
              -%}
            </a>
            <ul class="en-tete__sous-menu">
              <li><a href="{{ routes.collections_url }}" class="en-tete__sous-lien">Toutes les collections</a></li>
              <li><a href="{{ url_visage }}" class="en-tete__sous-lien">Soins du visage</a></li>
              <li><a href="{{ url_serums }}" class="en-tete__sous-lien">Sérums</a></li>
              <li><a href="{{ url_nettoyants }}" class="en-tete__sous-lien">Nettoyants</a></li>
              <li><a href="{{ url_hydratants }}" class="en-tete__sous-lien">Hydratants</a></li>
            </ul>
          </li>

          {%- comment -%} Engagements {%- endcomment -%}
          <li class="en-tete__item-nav">
            <a
              href="{{ url_engagements }}"
              class="en-tete__lien-nav font-corps text-nav text-vert-profond hover:text-sauge-fonce no-underline py-2 inline-block {% if actif_engagements %}est-actif{% endif %}"
              style="font-weight: 500;"
              {% if actif_engagements %}
                aria-current="page"
              {% endif %}
              >Engagements</a
            >
          </li>

          {%- comment -%} Quiz Peau {%- endcomment -%}
          <li class="en-tete__item-nav">
            <a
              href="{{ url_quiz }}"
              class="en-tete__lien-nav font-corps text-nav text-vert-profond hover:text-sauge-fonce no-underline py-2 inline-block {% if actif_quiz %}est-actif{% endif %}"
              style="font-weight: 500;"
              {% if actif_quiz %}
                aria-current="page"
              {% endif %}
              >Quiz Peau</a
            >
          </li>

          {%- comment -%} Blog {%- endcomment -%}
          <li class="en-tete__item-nav">
            <a
              href="{{ url_blog }}"
              class="en-tete__lien-nav font-corps text-nav text-vert-profond hover:text-sauge-fonce no-underline py-2 inline-block {% if actif_blog %}est-actif{% endif %}"
              style="font-weight: 500;"
              {% if actif_blog %}
                aria-current="page"
              {% endif %}
              >Blog</a
            >
          </li>

          <li class="en-tete__item-nav">
            <a
              href="{{ url_apropos }}"
              class="en-tete__lien-nav font-corps text-nav text-vert-profond hover:text-sauge-fonce no-underline py-2 inline-block {% if actif_apropos %}est-actif{% endif %}"
              style="font-weight: 500;"
              {% if actif_apropos %}
                aria-current="page"
              {% endif %}
              >À propos</a
            >
          </li>

        {%- else -%}
          {%- liquid
            assign current_path = request.path | downcase
            assign a_un_lien_principal_actif = false
            for menu_link in menu_admin
              assign menu_link_url = menu_link.url | split: '?' | first | downcase
              if menu_link_url == current_path
                assign a_un_lien_principal_actif = true
                break
              endif
            endfor
          -%}
          {%- comment -%} ----- Menu dynamique (depuis Shopify Navigation) ----- {%- endcomment -%}
          {%- for lien in menu_admin -%}
            {%- liquid
              assign est_actif_lien = false
              assign lien_url_normalise = lien.url | split: '?' | first | downcase

              if lien_url_normalise == current_path
                assign est_actif_lien = true
              endif

              if lien_url_normalise == '/collections' and request.page_type == 'collection' or lien_url_normalise == '/collections' and request.page_type == 'product' or lien_url_normalise == '/collections' and current_path contains '/collections/'
                assign est_actif_lien = true
              endif

              if lien_url_normalise contains '/blogs/' and request.page_type == 'blog' or lien_url_normalise contains '/blogs/' and request.page_type == 'article' or lien_url_normalise contains '/blogs/' and current_path contains '/blogs/'
                assign est_actif_lien = true
              endif

              if lien.links.size > 0 and a_un_lien_principal_actif == false
                for sous_lien in lien.links
                  assign sous_url_normalise = sous_lien.url | split: '?' | first | downcase
                  if sous_url_normalise == current_path
                    assign est_actif_lien = true
                    break
                  endif
                endfor
              endif
            -%}
            <li class="en-tete__item-nav relative group">
              <a
                href="{{ lien.url }}"
                class="en-tete__lien-nav font-corps text-nav text-vert-profond hover:text-sauge-fonce no-underline inline-flex items-center gap-1 py-2 {% if est_actif_lien %}est-actif{% endif %}"
                style="font-weight: 500;"
                {% if est_actif_lien %}
                  aria-current="page"
                {% endif %}
              >
                {{ lien.title }}
                {%- if lien.links.size > 0 -%}
                  {%- render 'icone',
                    nom: 'chevron-bas',
                    classe: 'inline-block transition-transform group-hover:rotate-180'
                  -%}
                {%- endif -%}
              </a>

              {%- if lien.links.size > 0 -%}
                <ul class="en-tete__sous-menu">
                  {%- for sous_lien in lien.links -%}
                    {%- liquid
                      assign sous_url_normalise = sous_lien.url | split: '?' | first | downcase
                      assign est_actif_sous_lien = false
                      if sous_url_normalise == current_path
                        assign est_actif_sous_lien = true
                      endif
                    -%}
                    <li>
                      <a
                        href="{{ sous_lien.url }}"
                        class="en-tete__sous-lien"
                        {% if est_actif_sous_lien %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ sous_lien.title }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </nav>

    {%- comment -%} ---------- Actions utilisateur ---------- {%- endcomment -%}
    <div class="en-tete__actions flex items-center gap-5 shrink-0 text-vert-profond">
      <a
        href="{{ routes.search_url }}"
        class="en-tete__action hover:text-sauge-fonce no-underline"
        aria-label="{{ 'general.recherche.titre' | t }}"
      >
        {%- render 'icone', nom: 'recherche' -%}
      </a>

      <a
        href="{{ routes.account_url }}"
        class="en-tete__action hover:text-sauge-fonce no-underline"
        aria-label="{{ 'compte.titre' | t }}"
      >
        {%- render 'icone', nom: 'compte' -%}
      </a>

      <a
        href="{{ routes.cart_url }}"
        class="en-tete__action en-tete__action--panier relative hover:text-sauge-fonce no-underline"
        aria-label="{{ 'panier.titre' | t }} ({{ cart.item_count }})"
        {% if settings.panier_drawer_actif %}
          data-ouvre-tiroir-panier
        {% endif %}
      >
        {%- render 'icone', nom: 'panier' -%}

        {%- comment -%} Badge compteur (caché si panier vide) {%- endcomment -%}
        <span
          class="en-tete__panier-compteur absolute -top-1 -right-2 min-w-[1.125rem] h-[1.125rem] px-1 inline-flex items-center justify-center rounded-full bg-vert-profond text-creme text-[0.65rem] font-corps {% if cart.item_count == 0 %}hidden{% endif %}"
          style="font-weight: 600;"
          data-compteur-panier
        >
          {{ cart.item_count }}
        </span>
      </a>
    </div>
  </div>
</header>

{%- render 'menu-mobile' -%}

{% schema %}
{
  "name": "En-tête",
  "tag": "section",
  "class": "section-en-tete",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "text",
      "id": "logo_texte",
      "label": "Logo (texte stylisé)",
      "default": "PURETÉ",
      "info": "Affiché en Cormorant Garamond. Laissez vide si vous utilisez une image."
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo (image)",
      "info": "Si défini, remplace le logo texte."
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu principal",
      "default": "main-menu"
    }
  ],
  "presets": [
    {
      "name": "En-tête"
    }
  ]
}
{% endschema %}
