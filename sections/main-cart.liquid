{%- comment -%}
  ============================================================
  Section : Panier principal (page /cart)
  Affiche les articles du panier, le récapitulatif et le bouton
  de paiement. Mise en page basique — à étoffer au design final.
  ============================================================
{%- endcomment -%}

<section class="panier container mx-auto py-12" data-section-id="{{ section.id }}">
  <h1 class="font-titre text-h3-bloc mb-8">{{ 'panier.titre' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <div class="panier__vide text-center py-16">
      <p class="font-corps text-vert-profond mb-6">{{ 'panier.vide' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="bouton bouton--primaire">
        {{ 'panier.continuer_achats' | t }}
      </a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" class="panier__formulaire">
      {%- comment -%} Liste des articles {%- endcomment -%}
      <ul class="panier__articles divide-y divide-vert-profond/10">
        {%- for article in cart.items -%}
          <li class="panier__article flex gap-4 py-6">
            {%- if article.image -%}
              <a href="{{ article.url }}" class="shrink-0">
                {{
                  article.image
                  | image_url: width: 200
                  | image_tag: class: 'w-24 h-24 object-cover bg-ivoire', alt: article.title, loading: 'lazy'
                }}
              </a>
            {%- endif -%}

            <div class="flex-1 flex flex-col sm:flex-row sm:items-center gap-4">
              <div class="flex-1">
                <a href="{{ article.url }}" class="font-corps text-vert-profond no-underline hover:text-sauge-fonce">
                  {{ article.product.title }}
                </a>
                {%- unless article.product.has_only_default_variant -%}
                  <p class="font-corps text-sm text-gris-doux mt-1">{{ article.variant.title }}</p>
                {%- endunless -%}
              </div>

              {%- comment -%} Quantité {%- endcomment -%}
              <div class="flex items-center gap-2">
                <label for="quantite-{{ article.key }}" class="sr-only">
                  {{ 'panier.quantite' | t }}
                </label>
                <input
                  type="number"
                  id="quantite-{{ article.key }}"
                  name="updates[{{ article.key }}]"
                  value="{{ article.quantity }}"
                  min="0"
                  class="w-16 px-2 py-1 border border-vert-profond/20 bg-ivoire text-center font-corps"
                >
              </div>

              {%- comment -%} Prix ligne {%- endcomment -%}
              <p class="font-corps font-medium text-vert-profond min-w-[5rem] text-right">
                {{ article.final_line_price | money }}
              </p>

              {%- comment -%} Lien suppression {%- endcomment -%}
              <a
                href="{{ article.url_to_remove }}"
                class="text-gris-doux hover:text-vert-profond text-sm no-underline"
                aria-label="{{ 'panier.supprimer' | t }}"
              >
                &times;
              </a>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- comment -%} Récapitulatif & paiement {%- endcomment -%}
      <div class="panier__recapitulatif mt-8 flex flex-col sm:flex-row sm:justify-between gap-6">
        <div class="flex gap-3">
          <button type="submit" name="update" class="bouton bouton--secondaire">
            {{ 'panier.mettre_a_jour' | t }}
          </button>
        </div>

        <div class="text-right">
          <p class="font-corps text-vert-profond mb-2">
            <span>{{ 'panier.sous_total' | t }} :</span>
            <strong class="ml-2">{{ cart.total_price | money }}</strong>
          </p>
          <p class="font-corps text-sm text-gris-doux mb-4">
            {{ 'panier.taxes_livraison' | t }}
          </p>
          <button type="submit" name="checkout" class="bouton bouton--primaire">
            {{ 'panier.passer_commande' | t }}
          </button>
        </div>
      </div>
    </form>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Panier principal",
  "tag": "section",
  "class": "section-panier",
  "settings": []
}
{% endschema %}
