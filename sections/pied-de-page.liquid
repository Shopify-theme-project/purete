{%- comment -%}
  ============================================================
  Section : Pied de page
  Liens secondaires, mentions légales, réseaux sociaux,
  inscription à la newsletter.
  ============================================================
{%- endcomment -%}

<footer class="pied-de-page" role="contentinfo">
  <div class="pied-de-page__conteneur">
    {%- for bloc in section.blocks -%}
      <div class="pied-de-page__colonne" {{ bloc.shopify_attributes }}>
        {%- case bloc.type -%}
          {%- when 'menu' -%}
            <h3>{{ bloc.settings.titre }}</h3>
            <ul>
              {%- for lien in bloc.settings.menu.links -%}
                <li>
                  <a href="{{ lien.url }}">{{ lien.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          {%- when 'texte' -%}
            <h3>{{ bloc.settings.titre }}</h3>
            <div>{{ bloc.settings.contenu }}</div>
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="pied-de-page__copyright">
    <small
      >&copy; {{ 'now' | date: '%Y' }}
      {{ shop.name }}. {{ 'pied_de_page.tous_droits_reserves' | t -}}
    </small>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "tag": "section",
  "class": "section-pied-de-page",
  "settings": [],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "titre", "label": "Titre", "default": "Liens utiles" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "texte",
      "name": "Bloc texte",
      "settings": [
        { "type": "text", "id": "titre", "label": "Titre" },
        { "type": "richtext", "id": "contenu", "label": "Contenu" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pied de page",
      "blocks": [{ "type": "menu" }, { "type": "texte" }]
    }
  ]
}
{% endschema %}
