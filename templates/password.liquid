<section class="page-mot-de-passe">
  <h1>{{ shop.name }}</h1>
  <p>{{ 'mot_de_passe.message' | t }}</p>
  {% form 'storefront_password' %}
    <label for="password">{{ 'mot_de_passe.label' | t }}</label>
    <input type="password" name="password" id="password" required>
    <button type="submit" class="bouton bouton--primaire">{{ 'mot_de_passe.entrer' | t }}</button>
    {{ form.errors | default_errors }}
  {% endform %}
</section>
