<!doctype html>
{%- comment -%}
  ============================================================
  Layout principal du thème Pureté
  Toutes les pages du site héritent de ce gabarit, à l'exception
  de celles utilisant un layout dédié (password.liquid, etc.).
  ============================================================
{%- endcomment -%}
<html lang="{{ request.locale.iso_code }}">
  <head>
    {%- comment -%} -- Méta techniques de base -- {%- endcomment -%}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="{{ settings.couleur_primaire }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- comment -%} -- Favicon -- {%- endcomment -%}
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- comment -%} -- SEO : titre et description -- {%- endcomment -%}
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- comment -%} -- Préchargement des polices critiques (above the fold) -- {%- endcomment -%}
    <link rel="preload" as="font" type="font/woff2" href="{{ 'police-cormorant-400.woff2' | asset_url }}" crossorigin>
    <link rel="preload" as="font" type="font/woff2" href="{{ 'police-inter-400.woff2' | asset_url }}" crossorigin>

    {{ content_for_header }}

    {%- comment -%} -- Feuille de style globale (Tailwind compilé) -- {%- endcomment -%}
    {{ 'application.css' | asset_url | stylesheet_tag }}

    {%- comment -%} -- Script global différé -- {%- endcomment -%}
    <script src="{{ 'application.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="modele--{{ template.name | handle }}">
    {%- comment -%} -- Lien d'évitement (accessibilité) -- {%- endcomment -%}
    <a class="lien-evitement" href="#contenu-principal">
      {{ 'accessibilite.aller_au_contenu' | t }}
    </a>

    {%- section 'barre-annonces' -%}
    {%- section 'en-tete' -%}

    <main id="contenu-principal" role="main">
      {{ content_for_layout }}
    </main>

    {%- section 'pied-de-page' -%}
  </body>
</html>
