<!doctype html>
{%- comment -%}
  Layout dédié à la page « mot de passe »
  (affichée quand la boutique est protégée par mot de passe).
{%- endcomment -%}
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {{ 'application.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="modele--password">
    <main role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
