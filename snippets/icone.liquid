{%- comment -%}
  ============================================================
  Snippet : Icône SVG (inline)
  Paramètres :
    - nom    : identifiant de l'icône (recherche, compte, panier, chevron-bas…)
    - classe : classe CSS additionnelle (optionnel)
    - taille : px (optionnel, défaut 22)

  Avantages de l'inline :
    - Aucune requête HTTP supplémentaire
    - currentColor hérite de la couleur du parent (text-vert-profond…)
    - Aucune dépendance à inline_asset_content
  ============================================================
{%- endcomment -%}

{%- liquid
  assign taille = taille | default: 22
-%}

<span class="icone icone--{{ nom }} {{ classe }} inline-flex" aria-hidden="true">
  {%- case nom -%}
    {%- when 'recherche' -%}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        width="{{ taille }}"
        height="{{ taille }}"
      >
        <circle cx="11" cy="11" r="7"/>
        <line x1="16.2" y1="16.2" x2="21" y2="21"/>
      </svg>

    {%- when 'compte' -%}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        width="{{ taille }}"
        height="{{ taille }}"
      >
        <circle cx="12" cy="8" r="4"/>
        <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/>
      </svg>

    {%- when 'panier' -%}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        width="{{ taille }}"
        height="{{ taille }}"
      >
        <path d="M6 8h12l-1 12.5a1.5 1.5 0 0 1-1.5 1.4h-9A1.5 1.5 0 0 1 5 20.5L6 8z"/>
        <path d="M9 8V6a3 3 0 0 1 6 0v2"/>
      </svg>

    {%- when 'chevron-bas' -%}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        width="14"
        height="14"
      >
        <polyline points="6 9 12 15 18 9"/>
      </svg>

      {%- comment -%} ----- Icônes bénéfices ----- {%- endcomment -%}

    {%- when 'feuille' -%}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        width="{{ taille }}"
        height="{{ taille }}"
      >
        <path d="M5 21c0-9 7-16 16-16 0 9-7 16-16 16z"/>
        <path d="M5 21c2-6 6-10 12-12"/>
      </svg>

    {%- when 'erlenmeyer' -%}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        width="{{ taille }}"
        height="{{ taille }}"
      >
        <path d="M9 3h6"/>
        <path d="M10 3v6L4.5 19a1.5 1.5 0 0 0 1.3 2.3h12.4A1.5 1.5 0 0 0 19.5 19L14 9V3"/>
        <path d="M7 15h10"/>
      </svg>

    {%- when 'carton' -%}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        width="{{ taille }}"
        height="{{ taille }}"
      >
        <path d="M3 7l9-4 9 4v10l-9 4-9-4V7z"/>
        <path d="M3 7l9 4 9-4"/>
        <path d="M12 11v10"/>
        <path d="M8 5l8 4"/>
      </svg>

      {%- comment -%} ----- Notation produit ----- {%- endcomment -%}

    {%- when 'etoile-pleine' -%}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        width="{{ taille }}"
        height="{{ taille }}"
      >
        <path d="M12 2l2.95 6.97L22 9.97l-5.5 4.78L18.18 22 12 18.27 5.82 22l1.68-7.25L2 9.97l7.05-1L12 2z"/>
      </svg>

    {%- when 'etoile-demi' -%}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="{{ taille }}"
        height="{{ taille }}"
      >
        <defs>
          <linearGradient id="demi-etoile-{{ taille }}">
            <stop offset="50%" stop-color="currentColor"/>
            <stop offset="50%" stop-color="currentColor" stop-opacity="0.25"/>
          </linearGradient>
        </defs>
        <path
          fill="url(#demi-etoile-{{ taille }})"
          d="M12 2l2.95 6.97L22 9.97l-5.5 4.78L18.18 22 12 18.27 5.82 22l1.68-7.25L2 9.97l7.05-1L12 2z"
        />
      </svg>

    {%- when 'etoile-vide' -%}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        fill-opacity="0.25"
        width="{{ taille }}"
        height="{{ taille }}"
      >
        <path d="M12 2l2.95 6.97L22 9.97l-5.5 4.78L18.18 22 12 18.27 5.82 22l1.68-7.25L2 9.97l7.05-1L12 2z"/>
      </svg>

    {%- when 'plus' -%}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        width="{{ taille }}"
        height="{{ taille }}"
      >
        <line x1="12" y1="5" x2="12" y2="19"/>
        <line x1="5" y1="12" x2="19" y2="12"/>
      </svg>

    {%- when 'croix' -%}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        width="{{ taille }}"
        height="{{ taille }}"
      >
        <line x1="6" y1="6" x2="18" y2="18"/>
        <line x1="18" y1="6" x2="6" y2="18"/>
      </svg>

    {%- when 'fleche-droite' -%}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        width="{{ taille }}"
        height="{{ taille }}"
      >
        <line x1="4" y1="12" x2="20" y2="12"/>
        <polyline points="14 6 20 12 14 18"/>
      </svg>
  {%- endcase -%}
</span>
